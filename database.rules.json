{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "devices": {
          "$deviceId": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },

    "userPresence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "conversations": {
      "$conversationId": {
        ".read": "auth != null && data.child('participants/' + auth.uid).val() === true",
        ".write": "auth != null && (data.child('participants/' + auth.uid).val() === true || (!data.exists() && newData.child('participants/' + auth.uid).val() === true))",
        "messages": {
          "$messageId": {
            ".read": "auth != null && root.child('conversations/' + $conversationId + '/participants/' + auth.uid).val() === true",
            ".write": "auth != null && root.child('conversations/' + $conversationId + '/participants/' + auth.uid).val() === true && newData.child('senderId').val() === auth.uid"
          }
        }
      }
    },

    "workerLocation": {
      "$workerId": {
        ".read": "auth != null",
        ".write": "auth != null && (data.child('uid').val() === auth.uid || (!data.exists() && newData.child('uid').val() === auth.uid))"
      }
    }
  }
}
